# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres. Use the DIRECT (unpooled) connection string, not the -pooler one:
# drizzle-kit opens a plain TCP connection for `pnpm db:push`, which the pooler
# endpoint will not serve.
# Shape (spaced so a secret scanner does not read this as a real credential):
#   postgresql:// <role> : <password> @ <host>.neon.tech / neondb ?sslmode=require
DATABASE_URL=

# Auth.js v5. Generate the secret with: npx auth secret
AUTH_SECRET=
# 3007 to match .claude/launch.json at the workspace root, which is the port
# `pnpm dev` is launched on. A mismatch here fails OAuth with redirect_uri_mismatch.
AUTH_URL=http://localhost:3007

# GitHub OAuth app (Settings -> Developer settings -> OAuth Apps).
# Callback URL must be exactly: http://localhost:3007/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
