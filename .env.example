# Copy this file to .env.local and fill in each value below.
#
#   cp .env.example .env.local
#
# .env.local is gitignored; this file is committed, so never put a real value
# here. Step by step instructions for obtaining each value: docs/SETUP.md

# ---------------------------------------------------------------------------
# 1. Neon Postgres                                      (console.neon.tech)
# ---------------------------------------------------------------------------
# Use the DIRECT connection string, NOT the one containing "-pooler":
# `pnpm db:push` opens a plain TCP connection, which the pooler endpoint will
# not serve. The running app is happy with either.
#
# The shape, with spaces so this committed file does not itself look like a
# leaked credential to a secret scanner. Paste the real one with no spaces:
#
#   postgresql:// <role> : <password> @ <host>.neon.tech / neondb ?sslmode=require
#
DATABASE_URL=

# ---------------------------------------------------------------------------
# 2. Auth.js session secret                                       (generated)
# ---------------------------------------------------------------------------
# Any 32+ byte random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(33).toString('base64'))"
AUTH_SECRET=

# The port `pnpm dev` runs on, from .claude/launch.json at the workspace root.
# Must match the GitHub OAuth callback below, or sign in fails with
# redirect_uri_mismatch.
AUTH_URL=http://localhost:3007

# ---------------------------------------------------------------------------
# 3. GitHub OAuth app            (github.com/settings/developers -> OAuth Apps)
# ---------------------------------------------------------------------------
# Homepage URL:               http://localhost:3007
# Authorization callback URL: http://localhost:3007/api/auth/callback/github
#
# The callback path is fixed by Auth.js, so do not shorten it. GitHub exposes
# no REST API for OAuth Apps, so this one has to be created in the browser.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
