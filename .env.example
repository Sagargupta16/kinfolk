# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres. Pooled connection string from the Neon dashboard.
DATABASE_URL=postgresql://user:password@host.neon.tech/kinfolk?sslmode=require

# Auth.js v5. Generate the secret with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# GitHub OAuth app (Settings -> Developer settings -> OAuth Apps).
# Callback URL must be exactly: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
