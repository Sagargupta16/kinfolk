{
	"name": "kinfolk",
	"version": "0.1.0",
	"private": true,
	"description": "Collaborative family tree maker: build your branch, connect it to relatives, see the combined tree",
	"packageManager": "pnpm@11.10.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@auth/drizzle-adapter": "^1.11.3",
		"@neondatabase/serverless": "^1.1.0",
		"@xyflow/react": "^12.11.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"elkjs": "^0.12.0",
		"lucide-react": "^1.24.0",
		"motion": "^12.42.2",
		"next": "^16.2.12",
		"next-auth": "5.0.0-beta.32",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^22.19.19",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.0.0",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"postcss": "^8.5.19",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
