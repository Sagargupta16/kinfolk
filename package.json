{
	"name": "kinfolk",
	"version": "0.5.2",
	"private": true,
	"description": "Collaborative family tree maker: build your branch, connect it to relatives, see the combined tree",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Sagargupta16/kinfolk.git"
	},
	"homepage": "https://sagargupta.online/kinfolk/",
	"bugs": {
		"url": "https://github.com/Sagargupta16/kinfolk/issues"
	},
	"packageManager": "pnpm@11.10.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"lint": "biome check .",
		"format": "biome check --write .",
		"db:push": "drizzle-kit push",
		"db:check-migrations": "tsx scripts/check-migrations.mts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"screenshots": "tsx scripts/capture-screenshots.mts",
		"bench:layout": "tsx scripts/bench-layout.mts"
	},
	"dependencies": {
		"@auth/drizzle-adapter": "^1.11.3",
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@neondatabase/serverless": "^1.2.0",
		"@xyflow/react": "^12.12.0",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.4",
		"elkjs": "^0.12.0",
		"lucide-react": "^1.59.0",
		"motion": "^13.0.0",
		"next": "^16.4.2",
		"next-auth": "5.0.0-beta.32",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@electric-sql/pglite": "^0.5.10",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.11",
		"playwright": "^1.64.1",
		"postcss": "^8.5.30",
		"sharp": "^0.35.5",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}
