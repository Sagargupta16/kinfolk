{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		// Vite's client types, for `import.meta.env` and the CSS module declarations.
		"types": ["vite/client"],
		"paths": {
			// The same `@/` the Next app uses, so a shared component's own imports
			// resolve unchanged.
			"@/*": ["../*"],
			// Three modules are REPLACED rather than reused. next/link and
			// next/navigation do not exist outside Next, and the server actions cannot
			// run in a browser, so each has a shim with an identical surface. Mapping
			// them here rather than editing eight components is what keeps one canvas.
			"next/link": ["./src/shims/next-link.tsx"],
			"next/navigation": ["./src/shims/next-navigation.ts"],
			"@/lib/tree/edit-actions": ["./src/shims/edit-actions.ts"],
			"@/lib/tree/share-actions": ["./src/shims/edit-actions.ts"],
			"@/lib/tree/demo-actions": ["./src/shims/edit-actions.ts"],
			"@/lib/tree/link-actions": ["./src/shims/edit-actions.ts"],
			"@/lib/tree/contact-state": ["./src/shims/edit-actions.ts"]
		}
	},
	"include": ["src", "vite.config.ts", "../components", "../lib"]
}
